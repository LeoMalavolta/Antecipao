    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Antecipação_de_Recebível</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
